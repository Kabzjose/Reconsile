# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Swap for Neon/Supabase/etc. if you don't use Docker.
DATABASE_URL="postgresql://reconcile:reconcile@localhost:5432/reconcile?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

# 12 is a sensible production value. Lower only for tests.
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (your Next.js app).
CORS_ORIGIN=http://localhost:3000

# Turns on /api/simulator/*, which can inject payments on a business's behalf — a demo
# convenience. Set to false in any real deployment.
ENABLE_SIMULATOR=true

# Public one-click access to the shared demo account for the hackathon. Set to false once
# this stops being a demo and the login should no longer be publicly exposed.
DEMO_LOGIN_ENABLED=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
